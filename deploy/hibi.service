[Unit]
Description=Hibi personal Japanese learning app
After=network.target postgresql.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/project/language-learning
Environment=NODE_ENV=production
EnvironmentFile=/home/admin/project/language-learning/.env
ExecStart=/home/admin/.nvm/versions/node/v24.18.0/bin/node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
