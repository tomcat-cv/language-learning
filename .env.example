# Server only. Never put keys into browser storage or source control.
OPENAI_API_KEY=
# OpenAI-compatible /v1 endpoint. Use a service available to your deployment.
AI_BASE_URL=https://api.openai.com/v1
# Set model IDs supported by your account; no model is silently selected.
CHAT_MODEL=
TRANSCRIBE_MODEL=
TTS_MODEL=
TTS_VOICE=alloy
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=3400
