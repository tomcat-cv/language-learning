{
  "name": "language-learning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "node scripts/verify-database.mjs",
    "content:download": "node scripts/content-sync.mjs download all",
    "content:import": "node --env-file=.env.local scripts/content-sync.mjs import all",
    "content:sync": "node --env-file=.env.local scripts/content-sync.mjs sync all",
    "content:catalog": "node scripts/build-source-catalog.mjs",
    "question-bank:import-official": "node scripts/import-jlpt-official.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@google/genai": "^1.28.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "openai": "^6.8.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
