{
  "name": "hibi-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node scripts/assemble.mjs && bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check": "npm run check:env && npm test && npm run build && npm run validate"
  }
}
